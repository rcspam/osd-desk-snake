         <property name="widgetResizable"><bool>true</bool></property>
         <widget class="QWidget" name="scrollContents_79">
          <layout class="QVBoxLayout" name="contentLayout_80">
           <item>
            <widget class="QGroupBox" name="group_81">
             <property name="title"><string>Labels</string></property>
             <layout class="QFormLayout" name="form_82">
              <item row="0" column="0">
               <widget class="QLabel" name="label_83">
                <property name="text"><string>Text:</string></property>
               </widget>
              </item>
              <item row="0" column="1">
               <widget class="QComboBox" name="kcfg_LabelSource">
