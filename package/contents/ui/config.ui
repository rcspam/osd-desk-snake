                 <property name="text"><string>Desktop number</string></property>
                </item>
                <item>
                 <property name="text"><string>Desktop name</string></property>
                </item>
                <item>
                 <property name="text"><string>Template</string></property>
                </item>
                <item>
                 <property name="text"><string>Custom list</string></property>
                </item>
               </widget>
              </item>
              <item row="1" column="0">
               <widget class="QLabel" name="label_84">
                <property name="text"><string>Template:</string></property>
               </widget>
              </item>
              <item row="1" column="1">
               <widget class="QLineEdit" name="kcfg_LabelTemplate">
                <property name="placeholderText"><string>D%d</string></property>
                <property name="toolTip"><string>%d is replaced by the desktop number, %n by its name.</string></property>
               </widget>
              </item>
              <item row="2" column="0">
               <widget class="QLabel" name="label_85">
                <property name="text"><string>Custom list:</string></property>
               </widget>
              </item>
              <item row="2" column="1">
               <widget class="QLineEdit" name="kcfg_LabelList">
                <property name="placeholderText"><string>Web, Code, Mail</string></property>
                <property name="toolTip"><string>One label per desktop, separated by commas. Missing entries show the number.</string></property>
               </widget>
              </item>
              <item row="3" column="0">
               <widget class="QLabel" name="label_86">
                <property name="text"><string>Font size:</string></property>
               </widget>
              </item>
              <item row="3" column="1">
               <widget class="QSpinBox" name="kcfg_FontSize">
                <property name="minimum"><number>0</number></property>
                <property name="maximum"><number>200</number></property>
                <property name="suffix"><string> px</string></property>
                <property name="toolTip"><string>0 uses the theme font size.</string></property>
               </widget>
              </item>
              <item row="4" column="0" colspan="2">
               <widget class="QCheckBox" name="kcfg_Bold">
                <property name="text"><string>Bold text</string></property>
               </widget>
              </item>
              <item row="5" column="0" colspan="2">
               <widget class="QCheckBox" name="kcfg_ActiveBold">
                <property name="text"><string>Bold text for the current desktop</string></property>
               </widget>
