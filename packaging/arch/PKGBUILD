# Maintainer: rcspam <https://github.com/rcspam>
pkgname=osd-desk-snake
pkgver=0.2.0
pkgrel=1
pkgdesc="Kara-style on-screen indicator for KDE Plasma 6 virtual desktop switches"
arch=('x86_64')
url="https://github.com/rcspam/osd-desk-snake"
license=('GPL-3.0-or-later')
depends=('kwin' 'kirigami' 'ksvg' 'qqc2-desktop-style'
         'kconfig' 'ki18n' 'kwindowsystem' 'qt6-base' 'qt6-declarative'
         'glibc' 'gcc-libs')
makedepends=('cmake' 'extra-cmake-modules' 'gettext')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('b43cc9953c78ef7758ea01e57e9c23b300ce7177e2800d617ac5861d9f83b329')

build() {
  cmake -B build -S "$pkgname-$pkgver" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
